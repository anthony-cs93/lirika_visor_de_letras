# Turso (libSQL) database used by the cloud sync API (/api/sync/*).
# Create one with `turso db create` and `turso db tokens create <db>`.
TURSO_DATABASE_URL="libsql://YOUR-DATABASE.turso.io"
TURSO_AUTH_TOKEN="YOUR_TURSO_AUTH_TOKEN"

# Optional: public URL of the site (used for canonical / Open Graph tags at build time).
# On Vercel this defaults to your production domain, so only set it for a custom domain.
SITE_URL="https://your-domain.com"

# Login: secret used to sign session cookies (long random string, e.g. `openssl rand -hex 32`). Required in production.
AUTH_SECRET="LONG_RANDOM_STRING"
# First admin account, created only while the users table is empty. Change the password after signing in.
ADMIN_USERNAME="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME_MIN_8_CHARS"

# Optional: shared account used by the "Ingresa sin cuenta" login button (create it from the admin panel first).
VITE_GUEST_USERNAME="invitado@lirika.app"
VITE_GUEST_PASSWORD="CHANGE_ME_MIN_8_CHARS"
