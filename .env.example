# Turso (libSQL) database used by the cloud sync API (/api/sync/*).
# Create one with `turso db create` and `turso db tokens create <db>`.
TURSO_DATABASE_URL="libsql://YOUR-DATABASE.turso.io"
TURSO_AUTH_TOKEN="YOUR_TURSO_AUTH_TOKEN"

# Optional: public URL of the site (used for canonical / Open Graph tags at build time).
# On Vercel this defaults to your production domain, so only set it for a custom domain.
SITE_URL="https://your-domain.com"
